# --- VARIÁVEIS DE AMBIENTE (ENV) ---
# Copie estas variáveis para o painel de Gerenciamento da Hostinger (Seção Node.js / Variáveis de Ambiente)

# Chave da API do Gemini (Obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="SUA_CHAVE_AQUI"

# URL Base da Aplicação (Ex: https://seu-dominio.com)
APP_URL="https://seu-dominio.com"

# Porta da aplicação (A Hostinger geralmente define isso automaticamente)
PORT=3000

# Ambiente (Mantenha production para hospedagem real)
NODE_ENV="production"
